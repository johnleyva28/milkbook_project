// Prisma schema for milkbook Postgres database.
// Run `npx prisma generate` (from this folder) to refresh the client.
// Run `npx prisma migrate dev --name <name>` to author a new migration.
// Run `npx prisma migrate deploy` to apply pending migrations (used by docker-compose).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = env("PRISMA_OUTPUT")
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Modelo placeholder. Reemplazar/expandir cuando se defina el
// dominio completo (HU pendiente: "Definir el modelo de datos Prisma completo").
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
